{
  "name": "@vibefork.me/editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Web editor for Vibefork.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b",
    "typecheck": "tsc -b",
    "check:budget": "node scripts/check-first-screen-budget.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:canvas": "node scripts/check-canvas.mjs",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "test": "vitest run",
    "check": "npm run build && npm run check:i18n && npm run check:budget && npm run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "force-graph": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.1.0",
    "playwright-core": "1.64.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
